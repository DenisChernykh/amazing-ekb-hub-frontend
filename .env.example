# Server-only backend origin for Next.js rewrites during full-stack development.
# Read by next.config.ts; do not expose through NEXT_PUBLIC_*.
API_BASE_URL=http://127.0.0.1:3000

# Shared HMAC secret for POST /api/cache/revalidate. Use at least 32 characters.
# Must exactly match FRONTEND_CACHE_REVALIDATION_SECRET in the backend environment.
CACHE_REVALIDATION_SECRET=
